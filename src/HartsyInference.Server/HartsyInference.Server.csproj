<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <PackageId>HartsyInference.Server</PackageId>
    <Description>OpenAI-compatible REST API server for HartsyInference — image generation, audio, vision endpoints with SSE streaming.</Description>
    <RootNamespace>HartsyInference.Server</RootNamespace>
    <OutputType>Exe</OutputType>
    <!-- ASP.NET Core 10 packages require net10 runtime; this project does not multi-target. -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Executable web server, not a consumable library — excluded from the alpha NuGet release.
         Can be shipped later if a hosted-server package is wanted. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HartsyInference.Core\HartsyInference.Core.csproj" />
    <ProjectReference Include="..\HartsyInference.ModelHandler\HartsyInference.ModelHandler.csproj" />
    <ProjectReference Include="..\HartsyInference.Tokenizers\HartsyInference.Tokenizers.csproj" />
    <ProjectReference Include="..\HartsyInference.Cpu\HartsyInference.Cpu.csproj" />
    <ProjectReference Include="..\HartsyInference.Cuda\HartsyInference.Cuda.csproj" />
    <ProjectReference Include="..\HartsyInference.Diffusion\HartsyInference.Diffusion.csproj" />
    <ProjectReference Include="..\HartsyInference.Audio\HartsyInference.Audio.csproj" />
    <ProjectReference Include="..\HartsyInference.Vision\HartsyInference.Vision.csproj" />
  </ItemGroup>

</Project>
