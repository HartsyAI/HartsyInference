<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Meta-package published as "SharpInference". It contains no code of its own — it just
    depends on every SharpInference library so a consumer can add ONE package and get the
    whole stack (dotnet add package SharpInference, prerelease).
  -->
  <PropertyGroup>
    <PackageId>SharpInference</PackageId>
    <Description>Meta-package for SharpInference — a pure C#/.NET AI inference engine for non-LLM modalities (diffusion image generation, speech-to-text, text-to-speech, vision, video, interactive world models). Adds all backends (CPU, CUDA, Vulkan) and modality packages in one reference.</Description>
    <!-- No build output: this package is dependencies-only. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- NU5128: "dependencies declared but no lib/ files" — expected and correct for a meta-package. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!-- Referenced projects become package dependencies of SharpInference. Listing all 11 libs
       (rather than relying on transitivity) keeps the dependency set explicit and complete. -->
  <ItemGroup>
    <ProjectReference Include="..\SharpInference.Core\SharpInference.Core.csproj" />
    <ProjectReference Include="..\SharpInference.Cpu\SharpInference.Cpu.csproj" />
    <ProjectReference Include="..\SharpInference.Cuda\SharpInference.Cuda.csproj" />
    <ProjectReference Include="..\SharpInference.Vulkan\SharpInference.Vulkan.csproj" />
    <ProjectReference Include="..\SharpInference.ModelHandler\SharpInference.ModelHandler.csproj" />
    <ProjectReference Include="..\SharpInference.Tokenizers\SharpInference.Tokenizers.csproj" />
    <ProjectReference Include="..\SharpInference.Diffusion\SharpInference.Diffusion.csproj" />
    <ProjectReference Include="..\SharpInference.Audio\SharpInference.Audio.csproj" />
    <ProjectReference Include="..\SharpInference.Vision\SharpInference.Vision.csproj" />
    <ProjectReference Include="..\SharpInference.Video\SharpInference.Video.csproj" />
    <ProjectReference Include="..\SharpInference.Interactive\SharpInference.Interactive.csproj" />
  </ItemGroup>

</Project>
