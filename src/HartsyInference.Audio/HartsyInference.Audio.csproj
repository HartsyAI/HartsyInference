<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>HartsyInference.Audio</PackageId>
    <Description>Audio inference for HartsyInference — Whisper STT, Kokoro TTS, voice conversion, mel-spectrogram preprocessing, audio codecs, and HuggingFace model caching.</Description>
    <RootNamespace>HartsyInference.Audio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HartsyInference.Core\HartsyInference.Core.csproj" />
    <ProjectReference Include="..\HartsyInference.ModelAssets\HartsyInference.ModelAssets.csproj" />
    <ProjectReference Include="..\HartsyInference.LLM\HartsyInference.LLM.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test project needs access to internals (LstmCell, WeightNormFusion, codec sub-classes)
         so per-layer numerical correctness can be tested without lifting everything to public. -->
    <InternalsVisibleTo Include="HartsyInference.Audio.Tests" />
    <!-- Dedicated phonemizer test project needs the internal dictionary/interpreter types to verify
         per-layer correctness against real espeak-ng data without lifting them to public. -->
    <InternalsVisibleTo Include="HartsyInference.Audio.Phonemizer.Tests" />
  </ItemGroup>

  <!-- Phoneme-mnemonic -> IPA map, generated offline by aligning espeak-ng's ascii and IPA phoneme output
       over an 8k-word corpus. Lets the phonemizer emit the IPA the TTS models were trained on. -->
  <ItemGroup>
    <EmbeddedResource Include="Phonemizer\Resources\ipa_phoneme_map.tsv" LogicalName="HartsyInference.Audio.Phonemizer.Resources.ipa_phoneme_map.tsv" />
    <!-- WithCulture=false: the ".en"/".en-us" infixes look like culture codes, which MSBuild would otherwise treat as
         satellite resources instead of embedding them in the main assembly. -->
    <EmbeddedResource Include="Phonemizer\Resources\ipa_phoneme_map.en.tsv" WithCulture="false" LogicalName="HartsyInference.Audio.Phonemizer.Resources.ipa_phoneme_map.en.tsv" />
    <EmbeddedResource Include="Phonemizer\Resources\ipa_phoneme_map.en-us.tsv" WithCulture="false" LogicalName="HartsyInference.Audio.Phonemizer.Resources.ipa_phoneme_map.en-us.tsv" />
  </ItemGroup>

  <!-- GPT-SoVITS Chinese G2P: per-character default pinyin (initial + tone-3 final) from pypinyin (~430 KB).
       Drives the (validated) PinyinPhonemizer for the common, non-polyphone path; g2pW refines polyphones. -->
  <ItemGroup>
    <EmbeddedResource Include="Frontends\Resources\pinyin_char_dict.txt" LogicalName="HartsyInference.Audio.Frontends.Resources.pinyin_char_dict.txt" />
    <!-- GPT-SoVITS English G2P: CMUdict (word → ARPAbet). OOV beyond letter-spelling needs the g2p_en LTS (future). -->
    <EmbeddedResource Include="Frontends\Resources\cmudict.rep" LogicalName="HartsyInference.Audio.Frontends.Resources.cmudict.rep" />
  </ItemGroup>

</Project>
