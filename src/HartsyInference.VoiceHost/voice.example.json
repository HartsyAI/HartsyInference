{
  "link": {
    // The gateway's link.socketPath must name the same file. The host unit's RuntimeDirectory creates the folder.
    "socketPath": "/run/hartsyinference/phone.sock",
    "socketMode": "0660",
    // The same token the gateway sends; both sides read it from a LoadCredential= file. Empty on both means no token.
    "tokenFile": "/run/credentials/hartsyinference-voice-host.service/phone-link-token",
    "prebufferMs": 40,
    "livenessTimeoutSeconds": 20
  },
  "models": {
    "llmModel": "qwen3",
    "llmDevice": "cuda:0",
    "audioDevice": "cuda:1",
    "sttModel": "whisper:openai/whisper-small.en",
    "ttsModel": "kokoro:af_heart",
    // Matches VoiceAgentOptions' own default (true); keep it true here too, or an install from this template runs
    // without RNNoise and voice.endpoint.ms silently loses the denoiser's ~40 ms. See VoiceHostConfigTests.TheShippedExampleParsesAndMapsOntoTheSessionOptions.
    "denoise": true,
    "wakeModelRoot": null
  },
  "agent": {
    "systemPrompt": null,
    "greeting": "Hello, how can I help you?",
    "resumeApology": "Sorry, the line dropped for a moment. Could you say that again?",
    "outboundSampleRate": 16000,
    "endOfTurnSilenceMs": 700,
    "maxUtteranceMs": 15000,
    "bargeInEnabled": true,
    "bargeInProbability": 0.6,
    "bargeInMinMs": 200,
    "bargeInHoldoffMs": 300,
    "maxToolRoundsPerTurn": 4,
    "maxHistoryTokens": 3000,
    "maxReplyTokens": 200,
    "firstSentenceMinChars": 12,
    "maxSentenceChars": 180
  },
  "tools": {
    "enabled": ["hangup", "send_dtmf", "transfer", "hold", "unhold", "play_prompt", "get_time"],
    "timeoutMs": 10000
  },
  "engine": {
    // numerics.cpuThreads for the host's lifetime: the 14 CPUs the unit allows (0-6,8-14).
    "cpuThreadCap": 14,
    // Empty reads the service user's ~/.config/hartsyinference/settings.json (paths.modelsRoot and the rest).
    "settingsFile": ""
  },
  "logging": {
    "level": "Info"
  }
}
