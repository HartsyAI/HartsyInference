{
  "sip": {
    "listenAddress": "0.0.0.0",
    "port": 5060,
    "transport": "udp",
    // Placeholder: your provider's registrar host[:port]. Empty means no registration (a LAN softphone setup).
    "registrar": "sip.example.net",
    "username": "hartsy",
    "passwordFile": "/run/credentials/hartsyinference-phone-gateway.service/sip-password",
    "registrationExpirySeconds": 60,
    "publicAddress": "none",
    "rtpPortStart": 20000,
    "rtpPortEnd": 20100,
    "codec": "Any",
    "inboundPolicy": "AllowAll",
    "allowlist": [],
    // Placeholder: the number prefixes outbound calls and the host's transfer tool may dial through the registrar.
    // Replace "+1555" with what your trunk should reach (a country code, area codes). Empty refuses every outbound
    // destination: the agent can be talked into dialling by its caller, so the dial plan fails closed.
    "destinationPrefixes": ["+1555"],
    // true dials any destination with no toll-fraud protection: a LAN or development only, never a real trunk.
    // It cannot be combined with destinationPrefixes (empty them first), and the gateway warns at start-up while it is on.
    "allowAnyDestination": false,
    "greetingPromptFile": null,
    "ringTimeoutSeconds": 45
  },
  "link": {
    "socketPath": "/run/hartsyinference/phone.sock",
    "tokenFile": "/run/credentials/hartsyinference-phone-gateway.service/phone-link-token",
    "outageHangupSeconds": 20
  },
  "admin": {
    "port": 9280,
    "tokenFile": "/run/credentials/hartsyinference-phone-gateway.service/phone-admin-token"
  },
  "media": {
    "fifoPriority": 50,
    "tickCpu": -1,
    "warmUpTicks": 200
  },
  "recording": {
    "enabled": false,
    "directory": "/var/lib/hartsyinference/phone-recordings"
  },
  "logging": {
    "level": "Info",
    "sipDebug": false
  }
}
