<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SharpInference.Vision</PackageId>
    <Description>Vision inference for SharpInference — CLIP embeddings, YOLO detection (planned), SAM segmentation (planned), and face detection (planned).</Description>
    <RootNamespace>SharpInference.Vision</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpInference.Core\SharpInference.Core.csproj" />
    <ProjectReference Include="..\SharpInference.ModelHandler\SharpInference.ModelHandler.csproj" />
    <ProjectReference Include="..\SharpInference.Tokenizers\SharpInference.Tokenizers.csproj" />
    <!--
      Vision depends on Diffusion because the existing ClipTextEncoder and ClipVisionEncoder
      live in SharpInference.Diffusion (originally built for SDXL conditioning and IP-Adapter).
      Reusing them here avoids duplicating the ViT/transformer math. The long-term fix is to
      hoist the CLIP encoders into a small shared package both Vision and Diffusion can depend
      on, so pure-Vision installs don't drag in the diffusion stack. Tracked in PHASE_6_VISION.md.
    -->
    <ProjectReference Include="..\SharpInference.Diffusion\SharpInference.Diffusion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpInference.Vision.Tests" />
  </ItemGroup>

</Project>
