<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SharpInference.Cuda</PackageId>
    <Description>CUDA GPU inference backend for SharpInference with PTX kernels and cuBLAS integration.</Description>
    <RootNamespace>SharpInference.Cuda</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpInference.Core\SharpInference.Core.csproj" />
    <ProjectReference Include="..\SharpInference.Cpu\SharpInference.Cpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpInference.Cuda.Tests" />
  </ItemGroup>

  <!-- PTX kernel files shipped as content, loaded from disk at runtime -->
  <ItemGroup>
    <Content Include="Ptx\*.ptx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
