<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>HartsyInference.Engine.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HartsyInference.Engine\HartsyInference.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The MoonViT-V2 tensor layout the LLM tests write, so the engine's vision checkpoint cannot drift from the tower loader. -->
    <Compile Include="..\HartsyInference.LLM.Tests\Kimi\Vision\KimiVisionSyntheticCheckpoint.cs"
             Link="Shared\KimiVisionSyntheticCheckpoint.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tiny glm5_next reference checkpoint and the real Sage chat template the LLM tests carry; the Text path test loads them as a directory. -->
    <None Include="..\HartsyInference.LLM.Tests\Fixtures\Glm5Next\tiny\*" Link="Fixtures\Glm5Next\tiny\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\HartsyInference.LLM.Tests\Fixtures\Glm5Next\sage-s21-flash-chat_template.jinja" Link="Fixtures\Glm5Next\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
