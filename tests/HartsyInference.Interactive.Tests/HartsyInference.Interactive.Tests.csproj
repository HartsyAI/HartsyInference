<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>HartsyInference.Interactive.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- World-model synthetic forward passes exercise unmanaged CPU kernels; a heap-corrupting test
         must not take out siblings via parallelism. Force single-threaded execution (mirrors Audio.Tests). -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <ProjectReference Include="..\..\src\HartsyInference.Interactive\HartsyInference.Interactive.csproj" />
    <ProjectReference Include="..\..\src\HartsyInference.Cpu\HartsyInference.Cpu.csproj" />
    <ProjectReference Include="..\..\src\HartsyInference.Cuda\HartsyInference.Cuda.csproj" />
    <ProjectReference Include="..\..\src\HartsyInference.ModelHandler\HartsyInference.ModelHandler.csproj" />
    <ProjectReference Include="..\..\src\HartsyInference.Tokenizers\HartsyInference.Tokenizers.csproj" />
    <ProjectReference Include="..\HartsyInference.Tests.Common\HartsyInference.Tests.Common.csproj" />
  </ItemGroup>

</Project>
