<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>HartsyInference.Audio.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <!-- Several audio models contain unmanaged ops that are not yet safe to run concurrently across test
       collections: under xunit's default parallelism a latent out-of-bounds write in one model corrupts a
       neighbouring tensor allocation and crashes an unrelated test with an AccessViolationException. The suite
       passes 372/372 sequentially, so force single-threaded execution (xunit.runner.json) until the underlying
       op is hardened. -->
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\Piper\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HartsyInference.Audio\HartsyInference.Audio.csproj" />
    <ProjectReference Include="..\..\src\HartsyInference.Cpu\HartsyInference.Cpu.csproj" />
    <ProjectReference Include="..\..\src\HartsyInference.Cuda\HartsyInference.Cuda.csproj" />
    <ProjectReference Include="..\..\src\HartsyInference.ModelHandler\HartsyInference.ModelHandler.csproj" />
    <ProjectReference Include="..\..\src\HartsyInference.Tokenizers\HartsyInference.Tokenizers.csproj" />
  </ItemGroup>

</Project>
