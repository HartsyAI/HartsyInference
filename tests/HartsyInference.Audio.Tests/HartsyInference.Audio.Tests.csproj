  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HartsyInference.Core\HartsyInference.Core.csproj" />
    <ProjectReference Include="..\..\src\HartsyInference.Audio\HartsyInference.Audio.csproj" />
    <ProjectReference Include="..\..\src\HartsyInference.ModelAssets\HartsyInference.ModelAssets.csproj" />
    <ProjectReference Include="..\..\src\HartsyInference.Engine\HartsyInference.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\GpuDeviceFacts.cs" Link="Shared\GpuDeviceFacts.cs" />
    <Compile Include="..\Shared\GpuRunKnobs.cs" Link="Shared\GpuRunKnobs.cs" />
  </ItemGroup>
</Project>
