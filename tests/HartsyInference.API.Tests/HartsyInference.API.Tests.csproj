<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>HartsyInference.API.Tests</RootNamespace>
    <!-- The API project targets net10.0 only (ASP.NET Core 10). -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <!-- Route tests host the real endpoint mapping on a loopback Kestrel port; no test-host package is needed. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\RealWeightsFactAttribute.cs" Link="Shared\RealWeightsFactAttribute.cs" />
    <!-- The synthetic Duo release the engine tests build, with the checkpoint writers it uses. -->
    <Compile Include="..\HartsyInference.Engine.Tests\Duo\DuoReleaseFixture.cs" Link="Shared\DuoReleaseFixture.cs" />
    <Compile Include="..\HartsyInference.ModelAssets.Tests\Duo\DcpFixture.cs" Link="Shared\DcpFixture.cs" />
    <Compile Include="..\HartsyInference.ModelAssets.Tests\Duo\PickleBuilder.cs" Link="Shared\PickleBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HartsyInference.API\HartsyInference.API.csproj" />
  </ItemGroup>

</Project>
