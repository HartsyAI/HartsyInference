<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>SharpInference.GpuBenchmarks</RootNamespace>
    <AssemblyName>SharpInference.GpuBenchmarks</AssemblyName>
    <!-- BenchmarkDotNet emits sample apps that intentionally exceed our project's strict warning rules; suppress for benches only. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpInference.Core\SharpInference.Core.csproj" />
    <ProjectReference Include="..\..\src\SharpInference.Cpu\SharpInference.Cpu.csproj" />
    <ProjectReference Include="..\..\src\SharpInference.Cuda\SharpInference.Cuda.csproj" />
  </ItemGroup>

  <!-- Copy compiled PTX kernels next to the benchmark executable so CudaBackend can locate them. -->
  <ItemGroup>
    <None Include="..\..\src\SharpInference.Cuda\Ptx\*.ptx">
      <Link>Ptx\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
