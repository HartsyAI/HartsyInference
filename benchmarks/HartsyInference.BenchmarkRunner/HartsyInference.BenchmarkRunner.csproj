<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks></TargetFrameworks><TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType><AssemblyName>hartsy-bench</AssemblyName>
    <RootNamespace>HartsyInference.BenchmarkRunner</RootNamespace><IsPackable>false</IsPackable>
    <BenchmarkRevision Condition="'$(BenchmarkRevision)' == ''">working-tree</BenchmarkRevision>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="web/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/HartsyInference.Engine/HartsyInference.Engine.csproj" />
    <AssemblyMetadata Include="BenchmarkRevision" Value="$(BenchmarkRevision)" />
    <Content Include="../suites/**/*.json" Link="suites/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
