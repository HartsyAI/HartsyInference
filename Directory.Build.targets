<Project>

  <!-- Pack the README into every packable project. One README serves both GitHub and nuget.org, so its
       links are absolute: nuget.org does not resolve repository-relative paths. The file must also be
       physically included or `dotnet pack` errors with NU5039. Imported here (after the csproj has set
       IsPackable) so non-packable projects (Cli, API, tests) skip it. -->
  <ItemGroup Condition=" '$(IsPackable)' != 'false' ">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
