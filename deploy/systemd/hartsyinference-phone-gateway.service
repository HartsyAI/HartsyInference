[Unit]
Description=HartsyInference phone gateway (SIP/RTP leg of the voice agent; no models)
Documentation=https://github.com/HartsyAI/HartsyInference/blob/main/docs/Research/PHONE_GATEWAY.md
Wants=network-online.target
After=network-online.target hartsyinference-voice-host.service
# The host owns the socket directory and the models. Requires= ties operator actions together: `systemctl stop` or
# `systemctl restart` of the host stops or restarts this gateway too, which drops every live call. A host crash does
# not propagate: systemd restarts the host on its own (Restart=always) and leaves the gateway running, which holds live
# calls with its "one moment" prompt and re-attaches them when the host is back within link.outageHangupSeconds.
Requires=hartsyinference-voice-host.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=hartsy
Group=hartsy
# Adjust to wherever `dotnet publish -c Release src/HartsyInference.PhoneGateway` was copied.
WorkingDirectory=/opt/hartsyinference/phone-gateway
ExecStart=/usr/bin/dotnet /opt/hartsyinference/phone-gateway/HartsyInference.PhoneGateway.dll --config /etc/hartsyinference/phone.json

# The rtprio limit the RTP tick thread needs to put itself under SCHED_FIFO 50 (media.fifoPriority). Never set
# CPUSchedulingPolicy=fifo on this service: that would make every thread real-time, sipsorcery's included.
LimitRTPRIO=50
Nice=-10
# The hyperthread pair of core 7: `lscpu -e` on this box shows CPU n and n+8 share a core. The voice host, the API server
# and (with the optional drop-in) SwarmUI stay off it. Set media.tickCpu to 7 or 15 in phone.json.
AllowedCPUs=7,15

# A 64 MB gen0 budget: sipsorcery allocates per packet, and a collection suspends even a FIFO thread. A runtime setting
# of the .NET GC, not one this repo's code reads; System.GC.Gen0Size in runtimeconfig.json is not honoured by .NET 10.
Environment=DOTNET_GCgen0size=0x4000000

# Secrets as credentials, copied to /run/credentials/hartsyinference-phone-gateway.service/<name> and named in phone.json.
# Every source file must exist: on a LAN with no registrar the SIP password is never read, so a placeholder will do.
LoadCredential=sip-password:/etc/hartsyinference/secrets/sip-password
LoadCredential=phone-link-token:/etc/hartsyinference/secrets/phone-link-token
LoadCredential=phone-admin-token:/etc/hartsyinference/secrets/phone-admin-token

Restart=always
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
