# Host tuning for the phone-call voice agent: the CPU frequency governor "performance" on every CPU, set at boot.
# Install and remove it with deploy/install-host-tuning.sh; see deploy/README.md, "Host tuning". An optimization: every
# voice gate passes under the stock schedutil governor. Stopping this unit changes nothing; `--revert` puts the CPUs on
# performance back on schedutil.
[Unit]
Description=HartsyInference host tuning: CPU frequency governor "performance" on every CPU
Documentation=https://github.com/HartsyAI/HartsyInference/blob/main/deploy/README.md#host-tuning
ConditionPathExists=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
Before=hartsyinference-voice-host.service hartsyinference-phone-gateway.service

[Service]
Type=oneshot
RemainAfterExit=yes
# No shell variables here: systemd would expand a "$" itself. The shell expands the glob; cpu[0-9]* skips the
# cpufreq/ and cpuidle/ directories next to the per-CPU ones.
ExecStart=/bin/sh -c 'echo performance | tee /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor >/dev/null'

[Install]
WantedBy=multi-user.target
