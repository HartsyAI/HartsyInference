<Project>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Alpha release version. Override -p:VersionSuffix=alpha.N on the pack command to bump. -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
  </PropertyGroup>

  <!-- Package metadata shared across all projects -->
  <PropertyGroup>
    <Authors>kalebbroo</Authors>
    <Company>SharpInference</Company>
    <Product>SharpInference</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/HartsyAI/SharpInference</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HartsyAI/SharpInference</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ai;inference;diffusion;stable-diffusion;flux;whisper;cuda;dotnet;csharp</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 kalebbroo</Copyright>
  </PropertyGroup>

  <!-- Closed alpha: do NOT ship symbols or SourceLink, so original source is not
       fetchable by consumers of the package. Re-enable when the repo goes public. -->
  <PropertyGroup>
    <IncludeSymbols>false</IncludeSymbols>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Analyzers -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Shared global usings file -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)GlobalUsings.cs" Link="GlobalUsings.cs" />
  </ItemGroup>

</Project>
