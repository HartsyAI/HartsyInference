<Project>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- SINGLE SOURCE OF TRUTH for the package version. Every Engine PR reserves its next version here, but the
       draft branch does not auto-publish it: publish-nuget.yml's automatic trigger runs only after merge or another
       push to main that touches source or packaging. Pin the SwarmUI extension only after that exact version is live
       on NuGet. A push with an already-published version is harmless because NuGet push uses skip-duplicate. A manual
       "Run workflow" is an explicit operator release and its version_suffix input still overrides this.
       (Note: never put a double-hyphen in this XML comment; it makes MSBuild fail to parse this file,
       which blanks TargetFrameworks and breaks restore with "Invalid framework identifier".) -->
  <PropertyGroup>
    <VersionPrefix>2.0.0</VersionPrefix>
    <VersionSuffix>alpha.50</VersionSuffix>
  </PropertyGroup>

  <!-- Package metadata shared across all projects -->
  <PropertyGroup>
    <Authors>kalebbroo</Authors>
    <Company>HartsyInference</Company>
    <Product>HartsyInference</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/HartsyAI/HartsyInference</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HartsyAI/HartsyInference</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ai;inference;diffusion;stable-diffusion;flux;whisper;cuda;dotnet;csharp</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 kalebbroo</Copyright>
  </PropertyGroup>

  <!-- Closed alpha: do NOT ship symbols or SourceLink, so original source is not
       fetchable by consumers of the package. Re-enable when the repo goes public. -->
  <PropertyGroup>
    <IncludeSymbols>false</IncludeSymbols>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Analyzers -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Shared global usings file -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)GlobalUsings.cs" Link="GlobalUsings.cs" />
  </ItemGroup>

</Project>
