<Project>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- SINGLE SOURCE OF TRUTH for the published version. CI (publish-nuget.yml) reads VersionSuffix
       from here and publishes 1.0.0-<VersionSuffix>. Bump this ONCE before each push (the push of this
       file is what triggers the publish), then pin the SAME version in the SwarmUI extension csproj.
       Pushing without bumping is harmless: NuGet push uses --skip-duplicate, so it just re-publishes
       nothing. A manual "Run workflow" with a version_suffix input still overrides this. -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>alpha.37</VersionSuffix>
  </PropertyGroup>

  <!-- Package metadata shared across all projects -->
  <PropertyGroup>
    <Authors>kalebbroo</Authors>
    <Company>HartsyInference</Company>
    <Product>HartsyInference</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/HartsyAI/HartsyInference</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HartsyAI/HartsyInference</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ai;inference;diffusion;stable-diffusion;flux;whisper;cuda;dotnet;csharp</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 kalebbroo</Copyright>
  </PropertyGroup>

  <!-- Closed alpha: do NOT ship symbols or SourceLink, so original source is not
       fetchable by consumers of the package. Re-enable when the repo goes public. -->
  <PropertyGroup>
    <IncludeSymbols>false</IncludeSymbols>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Analyzers -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Shared global usings file -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)GlobalUsings.cs" Link="GlobalUsings.cs" />
  </ItemGroup>

</Project>
