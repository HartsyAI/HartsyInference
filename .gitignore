## Generated output images (entire Output/ tree, including date-stamped subfolders and reference images)
/Output/

## Models (large weights — never committed). Use /Models/* + negation so tokenizer fixtures can be re-included.
/Models/*
## Exception: tokenizer asset files are small (KBs–low MBs) and useful as committed test fixtures
!/Models/Tokenizers/
## Re-ignore Qwen3 — its tokenizer.json is 11 MB; download from HF locally instead
/Models/Tokenizers/Qwen3/

## Python reference data (regenerated by running dump scripts)
tests/python-reference/*_reference_tensors/
# Gemma 4: the tiny-config dump's meta.json and the 32 MB real tokenizer.json are regenerated, never committed.
tests/python-reference/minimax_music3_reference/
tests/python-reference/gemma4_tiny_reference/
tests/python-reference/gemma4_tokenizer_reference/

