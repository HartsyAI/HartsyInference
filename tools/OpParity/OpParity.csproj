<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>HartsyInference.OpParity</RootNamespace>
    <AssemblyName>hartsy-opparity</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/HartsyInference.Engine/HartsyInference.Engine.csproj" />
  </ItemGroup>
  <!-- Compiled kernels beside the executable so BackendFactory resolves them the way the CLI does. -->
  <ItemGroup>
    <None Include="../../src/HartsyInference.Cuda/Ptx/*.ptx" Link="Ptx\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/HartsyInference.Vulkan/Spirv/*.spv" Link="Spirv\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
