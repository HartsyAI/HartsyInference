+def _h1_dump(latent, video_array, output_dir):
+    """H1 reference dump: the final latent and every decoded frame as lossless PNG. Off unless H1_DUMP_DIR is set."""
+    d = os.environ.get("H1_DUMP_DIR")
+    if not d:
+        return
+    os.makedirs(d, exist_ok=True)
+    lat = latent.detach().float().cpu().numpy() if hasattr(latent, "detach") else np.asarray(latent, dtype=np.float32)
+    np.save(os.path.join(d, "final_latent.npy"), lat)
+    for i, img in enumerate(video_array):
+        PIL.Image.fromarray(img).save(os.path.join(d, f"frame_{i:03d}.png"))
+
+
+def _h1_separate_enabled():
+    """H1: the demo's Kim_Vocal_2 separation runs only with H1_SEPARATE=1. The default is the speech file unchanged."""
+    return os.environ.get("H1_SEPARATE", "0") == "1"
+
+
+def _h1_speech(vocal_separator, source_path, duration=None):
+    """H1 pass-through: the speech file, mono at 16 kHz and cut to the clip length (the same format the separator returns)."""
+    if _h1_separate_enabled():
+        return separate_vocals(vocal_separator, source_path, duration=duration)
+    import librosa
+    mono, sr = librosa.load(source_path, sr=16000, mono=True)
+    if duration is not None:
+        mono = mono[: math.ceil(duration * 16000)]
+    return mono.astype(np.float32, copy=False), 16000
+
+
