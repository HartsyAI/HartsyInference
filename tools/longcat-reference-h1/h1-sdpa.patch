+def _h1_sdpa(q, k, v, scale):
+    """H1: torch SDPA in place of flash_attn_func. Inputs and output are [B, S, H, D], as flash_attn_func uses them."""
+    out = torch.nn.functional.scaled_dot_product_attention(q.transpose(1, 2), k.transpose(1, 2), v.transpose(1, 2), scale=scale)
+    return out.transpose(1, 2)
+
