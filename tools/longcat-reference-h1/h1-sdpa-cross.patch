+def _h1_varlen_sdpa(q, k, v, q_lens, k_lens):
+    """H1: torch SDPA with flash_attn_varlen_func's semantics: no causal mask, scale 1/sqrt(D), and query segment b attends only
+    to key segment b. q_lens and k_lens are per-sample lengths; the cumulative offsets are built here, as the flash call's cumsum does.
+    q is [Tq, H, D]; k and v are [Tk, H, D]. Fails loudly if the lengths do not cover the tensors."""
+    cu_q = [0]
+    for n in q_lens:
+        cu_q.append(cu_q[-1] + int(n))
+    cu_k = [0]
+    for n in k_lens:
+        cu_k.append(cu_k[-1] + int(n))
+    assert len(q_lens) == len(k_lens), (len(q_lens), len(k_lens))
+    assert cu_q[-1] == q.shape[0], f"query lengths sum to {cu_q[-1]}, the query tensor has {q.shape[0]} tokens"
+    assert cu_k[-1] == k.shape[0] == v.shape[0], f"key lengths sum to {cu_k[-1]}, the key tensor has {k.shape[0]} tokens"
+    outs = []
+    for b in range(len(q_lens)):
+        qs, qe = cu_q[b], cu_q[b + 1]
+        ks, ke = cu_k[b], cu_k[b + 1]
+        o = torch.nn.functional.scaled_dot_product_attention(
+            q[qs:qe].transpose(0, 1).unsqueeze(0),
+            k[ks:ke].transpose(0, 1).unsqueeze(0),
+            v[ks:ke].transpose(0, 1).unsqueeze(0),
+        )
+        outs.append(o.squeeze(0).transpose(0, 1))
+    return torch.cat(outs, 0)
