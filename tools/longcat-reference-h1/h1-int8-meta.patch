+def _h1_assign_state(model: nn.Module, state_dict: dict):
+    """H1: strict load by assignment into a model built on the meta device. The dtype each tensor ends with is the stock path's:
+    load_state_dict copies a bfloat16 checkpoint tensor into a float32 parameter, and the final loop of load_quantized_dit casts every
+    such parameter to bfloat16, so the stock final dtype is bfloat16. Every other tensor keeps its checkpoint dtype. A missing or
+    unexpected key fails. Nothing may stay on the meta device afterwards."""
+    model_keys = set(model.state_dict().keys())
+    ckpt_keys = set(state_dict.keys())
+    missing = sorted(model_keys - ckpt_keys)
+    unexpected = sorted(ckpt_keys - model_keys)
+    if missing or unexpected:
+        raise RuntimeError(f"H1 load: missing keys {missing[:10]} ({len(missing)}), unexpected keys {unexpected[:10]} ({len(unexpected)})")
+    model_tensors = model.state_dict(keep_vars=True)
+    float_params = {name for name, p in model.named_parameters() if p.dtype == torch.float32}
+    converted = {}
+    for name, tensor in state_dict.items():
+        if name in float_params and tensor.dtype == torch.bfloat16:
+            converted[name] = tensor.to(torch.bfloat16)
+            continue
+        target = model_tensors[name].dtype
+        if tensor.dtype != target:
+            raise RuntimeError(f"H1 load: {name} is {tensor.dtype} in the checkpoint but {target} in the model")
+        converted[name] = tensor
+    model.load_state_dict(converted, strict=True, assign=True)
+    leftover = [n for n, t in list(model.named_parameters()) + list(model.named_buffers()) if t.is_meta]
+    if leftover:
+        raise RuntimeError(f"H1 load: {len(leftover)} tensors are still on the meta device, e.g. {leftover[:5]}")
+    return model
+
